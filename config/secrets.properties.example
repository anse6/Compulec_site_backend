# Copiez ce fichier en config/secrets.properties et remplissez les valeurs.
application.security.jwt.secret-key=<openssl rand -base64 32>
app.security.encryption-key=<openssl rand -base64 32>
spring.mail.password=<mot de passe SMTP>
chatling.api.key=<clé API Chatling>
anthropic.api-key=<clé API Anthropic (facultative)>
app.bootstrap.admin.email=
app.bootstrap.admin.password=
